PORT=4000
NODE_ENV=development
# Փոխարինեք YOUR_PASSWORD-ը PostgreSQL տեղադրելիս նշած գաղտնաբառով
# (եթե գաղտնաբառում կան հատուկ նշաններ, օր.՝ @ կամ #, դրանք URL-encode արեք)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/sebastatsiner
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Առաջին ադմինի համար (npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Գլխավոր ադմինիստրատոր
